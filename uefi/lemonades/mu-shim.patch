-EFI_STATUS
-ShimInstallLib (
+// Shim registration is used during serialized early-boot initialization.
+// Names are owned by this loader; interface storage remains owned by callers.
+// Do not use this registry as a concurrent or post-ExitBootServices service.
+#define MAX_SHIM_LIBRARIES 32
+#define SHIM_NAME_POOL_SIZE 1024
+
+typedef struct {
+  CHAR8  *LibName;
+  UINT32  LibVersion;
+  VOID   *LibIntf;
+} SHIM_LIBRARY_ENTRY;
+
+STATIC SHIM_LIBRARY_ENTRY mShimLibraries[MAX_SHIM_LIBRARIES] = {
+  {"UEFI Config Lib", 0x10002, &ConfigLib},
+  {"SerialPort Lib",  0x10001, &SioLib}
+};
+STATIC UINTN mShimLibraryCount = 2;
+STATIC CHAR8 mShimNames[SHIM_NAME_POOL_SIZE];
+STATIC UINTN mShimNamesUsed = 0;
+
+STATIC EFI_STATUS
+ShimInstallLibUnlocked (
   IN CHAR8  *LibName,
   IN UINT32  LibVersion,
   IN VOID   *LibIntf)
 {
+  UINTN       Length;
+  UINTN       Size;
+  EFI_STATUS  Status;
+
+  if (LibName == NULL || LibIntf == NULL || LibName[0] == '\0') {
+    return EFI_INVALID_PARAMETER;
+  }
+  if (mShimLibraryCount >= MAX_SHIM_LIBRARIES) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  // Bound the scan and reserve the NUL even when length is divisible by four.
+  for (Length = 0; Length < sizeof (mShimNames); Length++) {
+    if (LibName[Length] == '\0') {
+      break;
+    }
+  }
+  if (Length == sizeof (mShimNames)) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Size = (Length + 1 + 3) & ~(UINTN)3;
+  if (Size > sizeof (mShimNames) - mShimNamesUsed) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Status = AsciiStrCpyS (&mShimNames[mShimNamesUsed], Size, LibName);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Append rather than replace: stock lookup prefers the earliest exact
+  // revision, or the earliest compatible revision if no exact match exists.
+  mShimLibraries[mShimLibraryCount].LibName = &mShimNames[mShimNamesUsed];
+  mShimLibraries[mShimLibraryCount].LibVersion = LibVersion;
+  mShimLibraries[mShimLibraryCount].LibIntf = LibIntf;
+  mShimNamesUsed += Size;
+  mShimLibraryCount++;
   return EFI_SUCCESS;
 }
 
