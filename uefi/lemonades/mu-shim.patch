   return EFI_NOT_FOUND;
 }
+
+// A nested or competing request must not observe a partly appended entry.
+// Fail promptly instead of spinning on a lock held by an interrupted caller.
+STATIC volatile UINT32 mShimRegistryBusy = 0;
+
+EFI_STATUS
+ShimInstallLib (
+  IN CHAR8  *LibName,
+  IN UINT32  LibVersion,
+  IN VOID   *LibIntf)
+{
+  EFI_STATUS Status;
+  if (LibName == NULL || LibIntf == NULL || LibName[0] == '\0') {
+    return EFI_INVALID_PARAMETER;
+  }
+  if (InterlockedCompareExchange32 (&mShimRegistryBusy, 0, 1) != 0) {
+    return EFI_NOT_READY;
+  }
+  Status = ShimInstallLibUnlocked (LibName, LibVersion, LibIntf);
+  InterlockedCompareExchange32 (&mShimRegistryBusy, 1, 0);
+  return Status;
+}
+
+EFI_STATUS
+ShimLoadLib (
+  IN  CHAR8   *LibName,
+  IN  UINT32   LibVersion,
+  OUT VOID   **LibIntf)
+{
+  EFI_STATUS Status;
+  if (LibIntf == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+  *LibIntf = NULL;
+  if (LibName == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+  if (InterlockedCompareExchange32 (&mShimRegistryBusy, 0, 1) != 0) {
+    return EFI_NOT_READY;
+  }
+  Status = ShimLoadLibUnlocked (LibName, LibVersion, LibIntf);
+  InterlockedCompareExchange32 (&mShimRegistryBusy, 1, 0);
+  return Status;
+}
